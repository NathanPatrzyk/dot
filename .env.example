DATABASE_URL=./data/app.db

OPENWEATHER_ENABLED=false           # liga/desliga a feature de clima
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/weather
OPENWEATHER_API_KEY=                # chave da API do OpenWeather (openweathermap.org/api)

GOOGLE_CLIENT_ID=                   # Client ID do OAuth (Google Cloud Console > Credentials)
GOOGLE_CLIENT_SECRET=               # Client Secret do OAuth (Google Cloud Console > Credentials)

BETTER_AUTH_SECRET=                 # string aleatória forte, ex: gerar com openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000