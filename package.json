{
  "name": "dot",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "prepare:cloudflare": "cross-env APP_TARGET=cloudflare tsx src/scripts/prepare-build.ts",
    "prepare:homelab": "cross-env APP_TARGET=homelab tsx src/scripts/prepare-build.ts",
    "dev:cloudflare": "pnpm prepare:cloudflare && vinext dev",
    "dev:homelab": "pnpm prepare:homelab && next dev",
    "build:cloudflare": "pnpm prepare:cloudflare && vinext build",
    "build:homelab": "pnpm prepare:homelab && next build",
    "start:cloudflare": "wrangler dev --config dist/server/wrangler.json",
    "start:homelab": "pnpm prepare:homelab && next start",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json --experimental-warm-cdn-cache",
    "db:generate:cloudflare": "drizzle-kit generate",
    "db:generate:homelab": "drizzle-kit generate --config drizzle.homelab.config.ts",
    "db:migrate:cloudflare": "wrangler d1 migrations apply dot-db",
    "db:migrate:cloudflare:local": "wrangler d1 migrations apply dot-db --local --config dist/server/wrangler.json",
    "db:migrate:homelab": "drizzle-kit migrate --config drizzle.homelab.config.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint",
    "test": "pnpm prepare:homelab && dotenv -e .env.local -- vitest run --bail 1 --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@vinext/cloudflare": "1.0.0-beta.6",
    "better-auth": "^1.6.25",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "^0.8.3",
    "lucide-react": "^1.23.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "1.0.0-beta.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "@vitest/coverage-v8": "^5.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.127.1"
  },
  "type": "module"
}
